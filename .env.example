# Local API bind address. Compose also uses these for the published host port.
APP_HOST=127.0.0.1
APP_PORT=8126

# A checkpoint trained on product defect data is required.
INSPECTION_CONFIG=configs/product_inspection.yml
INSPECTION_CKPT=ckpts/product_inspection.pth
MODEL_DEVICE=auto

WORK_DIR=outputs/jobs
TMP_DIR=outputs/tmp
VIDEO_FRAME_STEP=24
QUEUE_MAX_SIZE=4096
CALLBACK_TIMEOUT_S=5.0
CLASSIFY_BATCH_SIZE=16
MAX_CONCURRENT_GPU_JOBS=1
