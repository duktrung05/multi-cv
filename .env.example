# Local API bind address. Compose also uses these for the published host port.
APP_HOST=127.0.0.1
APP_PORT=8126

# A checkpoint trained on DGM4 face manipulation data is required.
CLASSIFICATION_CONFIG=configs/dgm4_binary.yml
CLASSIFICATION_CKPT=ckpts/dgm4_binary.pth
MODEL_DEVICE=auto

WORK_DIR=outputs/jobs
TMP_DIR=outputs/tmp
VIDEO_FRAME_STEP=24
QUEUE_MAX_SIZE=4096
CALLBACK_TIMEOUT_S=5.0
CLASSIFY_BATCH_SIZE=16
MAX_CONCURRENT_GPU_JOBS=1
